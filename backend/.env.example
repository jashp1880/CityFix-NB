ENVIRONMENT=development
DATABASE_URL=sqlite:///./cityfix.db
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
# Production: use PostgreSQL with TLS, e.g. postgresql+psycopg://...?...sslmode=require
# Private Supabase Storage (or fill the S3 settings below instead)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=cityfix-reports
# Private S3-compatible storage alternative
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional: configure a free-tier-only provider project; do not enable billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
